{
  "name": "smart-logistics-api",
  "version": "1.0.0",
  "description": "Smart Logistics Routing REST API with Dijkstra pathfinding, multi-stop waypoints, vehicle constraints, time-dependent peak hours, and async job execution.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest --runInBand --coverage",
    "test:watch": "jest --watch"
  },
  "keywords": [
    "logistics",
    "routing",
    "dijkstra",
    "graph",
    "typescript",
    "rest-api",
    "async-jobs"
  ],
  "author": "Victor",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^11.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.9",
    "@types/supertest": "^6.0.2",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "^10.0.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.6",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
